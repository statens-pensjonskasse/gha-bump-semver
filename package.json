{
  "name": "gha-bump-semver",
  "private": true,
  "description": "Bump a semver version up.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/statens-pensjonskasse/gha-bump-semver.git"
  },
  "author": "Statens Pensjonskasse",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc && ncc build lib/main.js -o dist --minify",
    "package": "npm run build",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch src/**/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage src/**/*.test.ts",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "format": "biome format",
    "format:fix": "biome format --fix",
    "all": "npm run format && npm run test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^2.0.1",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@statens-pensjonskasse/biome": "^2.0.22",
    "@types/node": "^24.1.0",
    "@types/semver": "^7.7.1",
    "@vercel/ncc": "^0.38.4",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
